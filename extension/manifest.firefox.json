{
  "manifest_version": 3,
  "name": "FlambHub — Bonus Hunt",
  "version": "2.1.0",
  "description": "Encoche flottante sur toutes les pages : ajoute et collecte tes bonus sans quitter ton casino.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Afficher / masquer FlambHub"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "flambhub@flambhub.vercel.app",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
