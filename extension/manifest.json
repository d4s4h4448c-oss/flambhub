{
  "manifest_version": 3,
  "name": "FlambHub — Bonus Hunt",
  "version": "1.6.0",
  "description": "Un panneau latéral compact pour ajouter et collecter tes bonus pendant que tu joues.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "action": {
    "default_title": "Ouvrir FlambHub — Bonus Hunt"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
